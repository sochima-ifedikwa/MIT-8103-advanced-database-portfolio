        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nerDiagram\n    direction TB\n\n    DEPARTMENTS {\n        int department_id PK\n        varchar department_code UK\n        varchar department_name\n    }\n\n    PROGRAMS {\n        int program_id PK\n        int department_id FK\n        varchar program_code UK\n        varchar program_name\n        varchar degree_level\n    }\n\n    STUDENTS {\n        int student_id PK\n        int program_id FK\n        varchar matric_number UK\n        varchar first_name\n        varchar last_name\n        varchar email UK\n        date admission_date\n        varchar student_status\n    }\n\n    LECTURERS {\n        int lecturer_id PK\n        int department_id FK\n        varchar staff_number UK\n        varchar first_name\n        varchar last_name\n        varchar email UK\n    }\n\n    COURSES {\n        int course_id PK\n        int department_id FK\n        varchar course_code UK\n        varchar course_title\n        int credit_units\n        int course_level\n    }\n\n    ACADEMIC_SESSIONS {\n        int session_id PK\n        varchar session_name UK\n        date start_date\n        date end_date\n    }\n\n    SEMESTERS {\n        int semester_id PK\n        int session_id FK\n        varchar semester_name\n        date start_date\n        date end_date\n    }\n\n    COURSE_OFFERINGS {\n        int offering_id PK\n        int course_id FK\n        int semester_id FK\n        int lecturer_id FK\n        int capacity\n    }\n\n    ENROLLMENTS {\n        int enrollment_id PK\n        int student_id FK\n        int offering_id FK\n        date registration_date\n        varchar enrollment_status\n    }\n\n    ASSESSMENTS {\n        int assessment_id PK\n        int offering_id FK\n        varchar assessment_name\n        numeric max_score\n        numeric weight_percentage\n    }\n\n    ASSESSMENT_SCORES {\n        int score_id PK\n        int assessment_id FK\n        int enrollment_id FK\n        numeric score\n    }\n\n    RESULTS {\n        int result_id PK\n        int enrollment_id FK,UK\n        numeric total_score\n        varchar letter_grade\n        numeric grade_point\n        date publication_date\n    }\n\n    DEPARTMENTS ||--o{ PROGRAMS : manages\n    DEPARTMENTS ||--o{ LECTURERS : employs\n    DEPARTMENTS ||--o{ COURSES : owns\n\n    PROGRAMS ||--o{ STUDENTS : admits\n\n    ACADEMIC_SESSIONS ||--o{ SEMESTERS : contains\n\n    COURSES ||--o{ COURSE_OFFERINGS : offered_as\n    SEMESTERS ||--o{ COURSE_OFFERINGS : schedules\n    LECTURERS ||--o{ COURSE_OFFERINGS : teaches\n\n    STUDENTS ||--o{ ENROLLMENTS : registers\n    COURSE_OFFERINGS ||--o{ ENROLLMENTS : receives\n\n    COURSE_OFFERINGS ||--o{ ASSESSMENTS : includes\n\n    ENROLLMENTS ||--o{ ASSESSMENT_SCORES : earns\n    ASSESSMENTS ||--o{ ASSESSMENT_SCORES : records\n\n    ENROLLMENTS ||--o| RESULTS : produces\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="eZejasW70N-eA07WoXxi-1">
